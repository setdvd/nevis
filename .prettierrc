{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
        { "files": ["package.json"], "options": { "tabWidth": 2 } },
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2, "singleQuote": false }
        }
    ]
}
