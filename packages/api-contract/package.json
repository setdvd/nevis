    "./fixtures": "./src/fixtures/clients.ts",
    "./example": "./src/clients-example.ts",
    "./http": "./src/http/with-request-timeout.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tanstack/react-query": "^5.104.5",
    "msw": "^3.0.3",
    "orval": "~8.44.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "msw": "^3.0.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  }
