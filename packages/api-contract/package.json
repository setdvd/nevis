{
  "name": "@nevis/api-contract",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "orval",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:generated": "pnpm generate && git diff --exit-code -- src/generated && test -z \"$(git status --porcelain -- src/generated)\""
