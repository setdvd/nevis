{
  "name": "nevis-clients-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "check": "eslint . --max-warnings 0 && prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --check . && pnpm -r typecheck && pnpm test",
    "test": "pnpm -r --if-present test",
    "check:e2e": "pnpm --filter @nevis/frontend e2e",
    "e2e:install": "pnpm --filter @nevis/frontend exec playwright install chromium --only-shell",
    "storybook": "pnpm --filter @nevis/frontend storybook",
    "generate": "pnpm --filter @nevis/api-contract generate",
    "check:generated": "pnpm --filter @nevis/api-contract check:generated",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
